MONGODB_URL=mongodb://mongodb:27017/pikachu_rl
MODEL_DIR=./models
REPLAY_DIR=./replays
MAX_REPLAYS=1000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_RPM=600
RATE_LIMIT_BURST=200
# Set to true when behind a reverse proxy (nginx) that sets X-Forwarded-For
# and strips external XFF headers. Off by default — XFF is spoofable for
# direct-internet deploys.
RATE_LIMIT_TRUST_PROXY=false
