{
  "title": "Logs — Aggregated (Loki)",
  "uid": "pikachu-logs",
  "tags": ["pikachu", "logs"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(env)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by service (lines/min)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (service, env) (count_over_time({env=~\"$env\", service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}} [{{env}}]",
          "refId": "A"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (matches ERROR/CRITICAL/Traceback)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" } },
      "targets": [
        {
          "expr": "sum by (env, service) (count_over_time({env=~\"$env\", service=~\"$service\"} |~ \"(?i)error|critical|traceback|exception\"[1m]))",
          "legendFormat": "{{service}} [{{env}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors (last 1h)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "sum by (env) (count_over_time({env=~\"$env\"} |~ \"(?i)error|critical|traceback|exception\"[1h]))",
          "legendFormat": "{{env}}",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Live tail",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "dedupStrategy": "exact",
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{env=~\"$env\", service=~\"$service\"}",
          "refId": "A",
          "maxLines": 500
        }
      ]
    }
  ]
}
