# Copy to deploy.env (gitignored) and fill in. Read by scripts/_common.sh and
# scripts/deploy-frontend.sh. In GitHub Actions the same names come from
# repository variables (Settings > Secrets and variables > Actions > Variables).

# Frontend host (nginx static serving)
FRONTEND_HOST=frontend.example.lan
FRONTEND_SSH_HOST=user@frontend.example.lan
FRONTEND_SSH_KEY=$HOME/.ssh/id_ed25519
FRONTEND_REMOTE_BASE=/home/user/pikachu-frontend

# Backend (GPU) host that nginx proxies /api and /ws to
BACKEND_HOST=gpu.example.lan

# Allowed browser origins per environment (docker compose interpolation)
CORS_ORIGINS_DEV=http://frontend.example.lan:3000,http://localhost:3000
CORS_ORIGINS_QA=http://frontend.example.lan:3001
CORS_ORIGINS_PROD=http://frontend.example.lan:3002

# Grafana admin password for docker-compose.monitoring.yml
GRAFANA_ADMIN_PASSWORD=change-me
